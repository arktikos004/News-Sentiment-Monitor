        "name": "spring-snappy",
        "value": "spring stiffness 520, damping 38, mass 0.7",
        "purpose": "分頁與分段控制的選中膠囊滑動。"
      },
      {
        "name": "spring-soft",
        "value": "spring stiffness 180, damping 26, mass 0.9",
        "purpose": "數值標記、長條。"
      },
      {
        "name": "press",
        "value": "scale(0.97)",
        "purpose": "按下回饋。"
      },
      {
        "name": "reduced-motion",
        "value": "prefers-reduced-motion: 動畫與轉場縮到 0.01ms",
        "purpose": "遵守使用者的減少動態設定。"
